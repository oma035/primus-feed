# Leave PRIMUS_PRIVATE_KEY empty to run in clearly-labelled DEMO MODE (real prices, no proofs).
# Burner wallet only! Pays Primus task fees + gas on the chosen chain.
PRIMUS_PRIVATE_KEY=
# 84532 = Base Sepolia (default, testnet) | 8453 = Base mainnet
PRIMUS_CHAIN_ID=84532
# Optional; defaults to the public Base RPC for the chain
PRIMUS_RPC_URL=https://sepolia.base.org
# How long an attestation is reused before a new one is made (seconds)
FEED_CACHE_TTL_SECONDS=300
# Optional; protects /api/cron (Vercel sends it automatically as a Bearer token)
CRON_SECRET=
